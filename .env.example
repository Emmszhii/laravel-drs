APP_NAME="DisasterResource+"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (PostgreSQL + PostGIS) ---
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=disasterresource
DB_USERNAME=postgres
DB_PASSWORD=change-me

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
FILESYSTEM_DISK=local

# --- Queue ---
QUEUE_CONNECTION=database

# --- Broadcasting / Laravel Reverb (realtime) ---
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# --- Optimization microservice ---
OPTIMIZATION_SERVICE_URL=http://solver-service:8001

# --- Routing (self-hosted OSRM, no API key required — see docker/osrm/prepare.sh) ---
OSRM_URL=http://osrm:5000

# --- Third-party location/geocoding (see SUMMARY.md) ---
PSGC_API_BASE=https://psgc.gitlab.io/api
NOMINATIM_BASE=https://nominatim.openstreetmap.org

# --- Disaster/calamity feed (USGS earthquakes + GDACS multi-hazard; both keyless, no API key needed) ---
DISASTER_FEED_USGS_URL=https://earthquake.usgs.gov/fdsnws/event/1/query
DISASTER_FEED_GDACS_URL=https://www.gdacs.org/gdacsapi/api/events/geteventlist/SEARCH
DISASTER_FEED_LOOKBACK_DAYS=3
# Max days an ACTIVE/MONITORING incident may sit with no open resource requests
# (and depot stock covering any remaining demand) before it auto-resolves.
DISASTER_FEED_AUTO_RESOLVE_MAX_DAYS=3

# --- SMS gateway (recommended: Semaphore or Movider for PH numbers) ---
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_SENDER_NAME=DisasterRes

# --- Mail ---
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@disasterresource.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
